# Copy to .env and adjust. Every value has a safe default, so .env is optional.
# The same variable names are set on the container platform in the cloud.

# local | docker | staging | production
APP_ENV=local
LOG_LEVEL=INFO

# Model artefact to serve (artifacts/models/credit_model_<MODEL_VERSION>.joblib)
MODEL_VERSION=v1.0.0

# Where the dashboard and monitoring job find the API
API_URL=http://localhost:8000

# Storage locations. In the cloud these are mounted volumes or bucket-backed paths.
# DATA_DIR=./data
# ARTIFACTS_DIR=./artifacts
# REPORTS_DIR=./reports
# DB_PATH=./data/platform.db

# Synthetic data generator
RANDOM_SEED=42
N_BORROWERS=4000
N_INCOMING_APPLICATIONS=600
